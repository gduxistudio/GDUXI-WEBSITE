<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen: logo on white (dark background in dark mode) -->
    <style name="Theme.GDUXI.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.GDUXI</item>
    </style>

    <!-- Main app theme. The light parent tells the website to use its light look. -->
    <style name="Theme.GDUXI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
